<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f3f7fa">
    <meta name="description" content="{{ page.description | default: site.description | strip_html | escape }}">
    <meta name="author" content="Yusu Fang">
    <meta name="keywords" content="Yusu Fang, robotics, computer vision, human motion, generative models, embodied AI, Carnegie Mellon University">
    <meta property="og:title" content="Yusu Fang · Robotics & Computer Vision">
    <meta property="og:description" content="{{ page.description | default: site.description | strip_html | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/me.png' | absolute_url }}">
    <title>Yusu Fang · Robotics &amp; Computer Vision</title>

    <script>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var saved = localStorage.getItem('yusu-theme');
          var preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = saved || preferred;
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <link rel="icon" href="assets/img/icon.png">
    <link rel="stylesheet" href="assets/css/homepage.css">
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <canvas class="motion-canvas" id="motion-canvas" aria-hidden="true"></canvas>
    <div class="page-glow" aria-hidden="true"></div>

    <nav class="site-nav" aria-label="Primary navigation">
      <div class="nav-shell">
        <a class="nav-brand" href="#top" aria-label="Yusu Fang, back to top">
          <span>Yusu Fang</span>
          <small>Robotics · Vision</small>
        </a>

        <div class="nav-actions">
          <div class="nav-links" id="nav-links">
            <a href="#about">About</a>
            <a href="#news">News</a>
            <a href="#publications">Publications</a>
            <a href="#education">Education</a>
            <a href="#experience">Experience</a>
          </div>

          <button class="icon-button menu-button" id="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="nav-links">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>

          <button class="icon-button theme-button" id="theme-toggle" type="button" aria-label="Switch color theme">
            <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"/></svg>
            <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
    </nav>

    <header class="hero" id="top">
      <div class="hero-shell">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> Ph.D. Student · CMU Robotics</p>
          <div class="name-lockup">
            <h1>Yusu<br>Fang</h1>
            <span class="name-note" aria-hidden="true">Human<br>Motion<br>&amp; AI</span>
          </div>
          <p class="hero-tagline">{{ page.tagline }}</p>

          <div class="hero-links" aria-label="Contact and social links">
            {% for social in page.socials %}
              <a class="social-pill" href="{{ social.url }}"{% unless social.key == 'email' %} target="_blank" rel="noopener noreferrer"{% endunless %}>
                {% case social.key %}
                  {% when 'email' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                  {% when 'github' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.7-1.4-2.3-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.6 1a9 9 0 0 1 4.8 0c1.8-1.2 2.6-1 2.6-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.6 0 3.7-2.3 4.5-4.6 4.7.4.3.7 1 .7 1.8v2.9c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.5Z"/></svg>
                  {% when 'scholar' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 9 9-5 9 5-9 5-9-5Z"/><path d="M6.5 11.3V16c1.5 1.4 3.3 2.1 5.5 2.1s4-.7 5.5-2.1v-4.7M21 9v6"/></svg>
                  {% when 'linkedin' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 9.5V19M6.5 5.5v.1M10.5 19v-5.4c0-2.3 3.1-3.2 4.7-1.5.5.5.8 1.3.8 2.2V19M4 9.5h5V19H4zM10.5 9.5V19H16v-4.7"/></svg>
                  {% when 'x' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5 19 19.5M19 4.5 5 19.5"/></svg>
                {% endcase %}
                <span>{{ social.label }}</span>
              </a>
            {% endfor %}
          </div>
        </div>

        <div class="portrait-wrap">
          <div class="portrait-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="portrait-frame">
            <img class="portrait-image portrait-image--light" src="assets/img/me.png" alt="Portrait of Yusu Fang" width="1365" height="2048">
            <img class="portrait-image portrait-image--dark" src="assets/img/me_dark.png" alt="" width="1365" height="2048" aria-hidden="true">
          </div>
          <p class="portrait-caption"><span>01</span> Yusu in motion, always.</p>
        </div>
      </div>
      <a class="scroll-cue" href="#about" aria-label="Scroll to About"><span></span>Explore</a>
    </header>

    <main class="page-shell" id="main-content">
      <section class="content-section reveal" id="about">
        <div class="section-heading">
          <span class="section-index">01</span>
          <h2>About</h2>
          <span class="section-rule"></span>
        </div>
        <div class="about-grid">
          <div class="about-copy">{{ content }}</div>
          <aside class="research-note">
            <span class="note-label">Research lens</span>
            {{ page.research_statement | markdownify }}
          </aside>
        </div>
      </section>

      <section class="content-section reveal" id="news">
        <div class="section-heading">
          <span class="section-index">02</span>
          <h2>News</h2>
          <span class="section-rule"></span>
        </div>
        <ol class="news-list">
          {% for item in page.news %}
            <li>
              <time datetime="{{ item.datetime }}">{{ item.date }}</time>
              <div>{{ item.text }}</div>
            </li>
          {% endfor %}
        </ol>
      </section>

      <section class="content-section reveal" id="publications">
        <div class="section-heading">
          <span class="section-index">03</span>
          <h2>Selected Publications</h2>
          <span class="section-rule"></span>
        </div>
        <div class="publication-list">
          {% for publication in page.publications %}
            <article class="publication-card">
              <div class="publication-visual">
                <img src="{{ publication.preview | remove_first: '/' }}" alt="Preview for {{ publication.title }}" loading="lazy">
                <span class="venue-badge">{{ publication.venue }} · {{ publication.year }}</span>
              </div>
              <div class="publication-copy">
                <h3>{{ publication.title }}</h3>
                <p class="publication-authors">{{ publication.authors }}</p>
                {% if publication.note %}<p class="publication-note">{{ publication.note }}</p>{% endif %}
                {% if publication.links %}
                  <div class="publication-links">
                    {% for link in publication.links %}
                      <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }} <span aria-hidden="true">↗</span></a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
        <p class="publication-footnote"><sup>*</sup> Equal contribution. See the complete list on <a href="https://scholar.google.com/citations?hl=en&user=RZiiW3gAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>.</p>
      </section>

      <section class="content-section reveal" id="education">
        <div class="section-heading">
          <span class="section-index">04</span>
          <h2>Education</h2>
          <span class="section-rule"></span>
        </div>
        <div class="timeline-list education-list">
          {% for item in page.education %}
            <article class="timeline-card">
              <a class="institution-logo" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{ item.institution }}">
                <img src="{{ item.logo | remove_first: '/' }}" alt="{{ item.logo_alt }}">
              </a>
              <div class="timeline-copy">
                <div class="timeline-topline">
                  <h3><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.institution }}</a></h3>
                  <time>{{ item.period }}</time>
                </div>
                <p class="timeline-place">{{ item.location }}</p>
                <p class="timeline-description">{{ item.degree }}</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>

      <section class="content-section reveal" id="experience">
        <div class="section-heading">
          <span class="section-index">05</span>
          <h2>Experience</h2>
          <span class="section-rule"></span>
        </div>
        <div class="timeline-list experience-list">
          {% for item in page.experiences %}
            <article class="timeline-card experience-card">
              <a class="institution-logo" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{ item.institution }}">
                <img src="{{ item.logo | remove_first: '/' }}" alt="{{ item.logo_alt }}">
              </a>
              <div class="timeline-copy">
                <div class="timeline-topline">
                  <h3><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.institution }}</a></h3>
                  <time>{{ item.period }}</time>
                </div>
                <p class="timeline-place">{{ item.location }}</p>
                <p class="timeline-description">
                  {{ item.role }} with <a href="{{ item.advisor_url }}" target="_blank" rel="noopener noreferrer">{{ item.advisor }}</a>
                  {% if item.co_advisor %} and <a href="{{ item.co_advisor_url }}" target="_blank" rel="noopener noreferrer">{{ item.co_advisor }}</a>{% endif %}
                  <span class="topic-separator" aria-hidden="true">·</span>
                  <strong>{{ item.focus }}</strong>
                </p>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-shell">
        <p>© {{ 'now' | date: '%Y' }} Yusu Fang</p>
        <p>Designed around motion, perception, and a little daydreaming.</p>
        <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <script src="assets/js/homepage.js" defer></script>
  </body>
</html>
